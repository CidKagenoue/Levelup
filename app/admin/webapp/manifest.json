{
  "_version": "1.60.0",
  "sap.app": {
    "id": "admingamemanager.admin",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.33.0",
      "toolsId": "fdd265b3-5229-4c0e-a7d6-4928dcc26c0a"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/admin/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "orders": {
        "uri": "/odata/v4/orders/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.51",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "admingamemanager.admin.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "orders": {
        "dataSource": "orders",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "GamesList",
          "target": "GamesList"
        },
        {
          "pattern": "Games({key}):?query:",
          "name": "GamesObjectPage",
          "target": "GamesObjectPage"
        },
        {
          "pattern": "orders",
          "name": "OrderList",
          "target": "OrderList"
        }
      ],
      "targets": {
        "GamesList": {
          "type": "Component",
          "id": "GamesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Games",
              "variantManagement": "Page",
              "navigation": {
                "Games": {
                  "detail": {
                    "route": "GamesObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "actions": {
                    "MyOrders": {
                      "text": "{i18n>myOrders}",
                      "press": "admingamemanager.admin.ext.controller.GamesListExtension.onMyOrders",
                      "requiresSelection": false
                    }
                  },
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "GamesObjectPage": {
          "type": "Component",
          "id": "GamesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Games",
              "content": {
                "body": {
                  "sections": {
                    "GameReviews": {
                      "template": "admingamemanager.admin.ext.fragment.Reviews",
                      "title": "{i18n>reviews}"
                    }
                  }
                }
              }
            }
          }
        },
        "OrderList": {
          "type": "Component",
          "id": "OrderList",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "viewName": "admingamemanager.admin.ext.view.OrderList",
              "contextPath": "/Orders"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "admingamemanager.admin.ext.controller.GamesListExtension"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
